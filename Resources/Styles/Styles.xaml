<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Implicit styles ===== -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource Sky}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Sky}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Shell.FlyoutBehavior" Value="Disabled" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Green}" />
        <Setter Property="ThumbColor" Value="White" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource Orange}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource PaperEdge}" />
        <Setter Property="ThumbColor" Value="{StaticResource Orange}" />
    </Style>

    <Style TargetType="Stepper">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- ===== Named styles ===== -->

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="Display" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label" BasedOn="{StaticResource Display}">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource Ink}" Offset="0,3" Radius="0" Opacity="0.8" />
        </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label" BasedOn="{StaticResource Display}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource WoodDark}" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="LineHeight" Value="1.15" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource InkSoft}" />
    </Style>

    <Style x:Key="PaperCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Paper}" />
        <Setter Property="Stroke" Value="{StaticResource WoodDark}" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Shadow">
            <Shadow Brush="Black" Offset="0,6" Radius="12" Opacity="0.3" />
        </Setter>
    </Style>

    <Style x:Key="WoodPanel" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource WoodDark}" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource WoodLight}" Offset="0" />
                <GradientStop Color="{StaticResource Wood}" Offset="1" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="Black" Offset="0,3" Radius="4" Opacity="0.3" />
        </Setter>
    </Style>

    <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Stroke" Value="{StaticResource PaperEdge}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="8,10" />
    </Style>

    <Style x:Key="HudText" TargetType="Label" BasedOn="{StaticResource Display}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource Ink}" Offset="0,2" Radius="0" Opacity="0.7" />
        </Setter>
    </Style>

</ResourceDictionary>
